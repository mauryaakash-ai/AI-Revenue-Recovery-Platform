# ==========================================
# RAZORPAY AI REVENUE RECOVERY PLATFORM (RevPilot)
# Configuration & Provider Credentials
# ==========================================

# Core Application Settings
DATABASE_URL=sqlite:///./revenue_recovery.db
ENVIRONMENT=development
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ==========================================
# 1. WHATSAPP GATEWAY (Choose 1)
# ==========================================
# Option A: Meta WhatsApp Business Cloud API (Official)
WHATSAPP_CLOUD_API_TOKEN=your_meta_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Option B: Gupshup / Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==========================================
# 2. SMS GATEWAYS
# ==========================================
# Gupshup / Karix / Twilio
TWILIO_FROM_NUMBER=+18005550199
GUPSHUP_API_KEY=your_gupshup_api_key

# ==========================================
# 3. VOICE CALLS & AI IVR (Indian PSTN & VoIP)
# ==========================================
# Option A: Exotel (Leading Indian Telecom & IVR Provider)
EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_token
EXOTEL_CALLER_ID=080XXXXXXXX

# Option B: Conversational AI Voice Agents (Hinglish/English)
# (Vapi / Bland AI / Retell AI / Sarvam AI)
VOICE_AI_API_KEY=your_voice_ai_api_key
SARVAM_AI_API_KEY=your_sarvam_ai_api_key

# ==========================================
# 4. EMAIL PROVIDERS
# ==========================================
SENDGRID_API_KEY=your_sendgrid_api_key
RESEND_API_KEY=your_resend_api_key
